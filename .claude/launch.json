{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chefer/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chefer/api", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "chefer-ad-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "marketing/chefer-ad",
        "run",
        "dev",
        "--",
        "--port",
        "3123",
        "--no-open"
      ],
      "port": 3123
    }
  ]
}
