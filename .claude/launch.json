{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chefer/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chefer/api", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "api-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3011",
        "AI_MOCK_ENABLED=true",
        "AI_MOCK_DELAY_MS=1500",
        "RATE_LIMIT_MAX=3000",
        "pnpm",
        "--filter",
        "@chefer/api",
        "dev"
      ],
      "port": 3011
    },
    {
      "name": "metro-study",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3011",
        "pnpm",
        "--filter",
        "@chefer/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
