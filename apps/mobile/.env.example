# Base URL of the Chefer API. Leave unset for simulator/emulator development —
# the app defaults to http://localhost:3001 (iOS) / http://10.0.2.2:3001
# (Android emulator). A PHYSICAL device must point at the host's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3001

# Sentry error reporting — disabled when unset.
# EXPO_PUBLIC_SENTRY_DSN=

# Usage analytics (T-12.2, §5.10) — a pure-JS PostHog HTTP transport, no SDK.
# No key = no-op: nothing is queued, no fetch ever fires. When set, the host
# MUST be the EU cloud (eu.i.posthog.com, rev 2 D24) — anything else fails
# validation at startup.
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Apple team ID for signing LOCAL device builds (expo run:ios --device).
# Find it: Xcode » Settings » Accounts, or the OU= field of
# `security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject`.
# Not needed for simulator builds or EAS cloud builds.
# EXPO_APPLE_TEAM_ID=

# Sign in with Google / Apple (WP-22) — NATIVE build-time values, all optional
# (a build without them still succeeds; the Google button then stays hidden on
# iOS). They are part of the native fingerprint: use the SAME values for every
# binary build and every OTA publish (this file for local scripts, eas.json
# build.production.env for EAS cloud builds, the GOOGLE_IOS_URL_SCHEME repo
# VARIABLE for the CI "Mobile OTA update" job).
# Reversed iOS OAuth client id from Google Cloud (type "iOS", bundle
# com.popdan.chefer): com.googleusercontent.apps.<digits-and-letters>
# Production builds default to the production iOS client (app.config.js);
# set this only to override it, identically everywhere a binary is built.
# GOOGLE_IOS_URL_SCHEME=
# …or give the client id itself (<id>.apps.googleusercontent.com) and the
# scheme is derived:
# GOOGLE_IOS_CLIENT_ID=
# Production builds always carry the Sign in with Apple entitlement and the
# webcredentials associated domain (host of EXPO_PUBLIC_API_URL). Set to 1 to
# add them to a development build too (needs the PAID Apple team):
# ENABLE_APPLE_SIGN_IN=1

# App variant — do NOT set it here. development (default, "Chefer Dev") vs
# production ("Chefer", prod API, OTA updates); the release/update scripts in
# scripts/ set APP_VARIANT=production and the prod EXPO_PUBLIC_API_URL
# themselves, overriding anything in this file.
# APP_VARIANT=development
