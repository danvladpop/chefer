{
  "name": "@chefer/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bundle:check": "expo export --platform ios --output-dir .expo-export-check",
    "clean": "rm -rf .expo .expo-export-check dist"
  },
  "dependencies": {
    "@chefer/types": "workspace:*",
    "@chefer/utils": "workspace:*",
    "@tanstack/react-query": "^5.50.0",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chefer/eslint-config": "workspace:^",
    "@types/react": "~19.2.2",
    "eslint": "^9.7.0",
    "typescript": "^5.5.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
