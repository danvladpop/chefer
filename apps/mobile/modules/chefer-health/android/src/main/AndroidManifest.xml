<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Health Connect's "privacy policy" link in its permission screens (C2).
      Through Android 13 it sends ACTION_SHOW_PERMISSIONS_RATIONALE; from
      Android 14 VIEW_PERMISSION_USAGE through the alias, which only the
      system may start. Either one brings Chefer forward on its Privacy Policy.
    -->
    <activity
      android:name=".HealthRationaleActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name=".ViewPermissionUsageActivity"
      android:exported="true"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
      android:targetActivity=".HealthRationaleActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
