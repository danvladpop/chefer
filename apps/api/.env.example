# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chefer_dev

# Auth / JWT
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── AI (Chefer) ───────────────────────────────────────────────────────────────
# Set AI_MOCK_ENABLED=true locally — no real LLM calls, no token spend.
# Set AI_MOCK_ENABLED=false to use a real AI provider (set the key below too).
AI_MOCK_ENABLED=true
AI_MOCK_DELAY_MS=0

# Free-only mode: every AI workload on Groq's free tier, failing over to
# Cloudflare Workers AI's free plan (no card, nothing billed). Gemini is never
# used and GEMINI_API_KEY is not needed; the API refuses to start if an
# AI_ROUTE_*/AI_SHADOW_ROUTE line still names gemini. Needs AI_SECONDARY_API_KEY
# (Groq) and CF_ACCOUNT_ID + CF_API_TOKEN (below). docs/ai-providers.md
# "Free-only mode". Empty/false = the standard routing below, unchanged.
AI_FREE_ONLY=false

# Which provider to use when AI_MOCK_ENABLED=false.
# Options: gemini (primary, with optional failover) | openai (secondary standalone)
AI_PROVIDER=gemini

# Gemini (free tier — get key at https://aistudio.google.com)
# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model names (defaults shown) — change to move models without a code change.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Secondary OpenAI-compatible provider ("groq" in the routes below).
# With AI_PROVIDER=gemini: setting AI_SECONDARY_API_KEY enables automatic
# failover on Gemini capacity/quota errors + groq-first routing for cheap
# high-volume calls (chat, ingredient prices, shopping list). Leave empty to
# run Gemini alone. Defaults target Groq's free tier (key at
# https://console.groq.com).
AI_SECONDARY_API_KEY=
AI_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
AI_SECONDARY_MODEL=openai/gpt-oss-120b
# Vision model at the same endpoint — used only when AI_ROUTE_VISION sends
# photos there. Video recipe extraction is always Gemini.
AI_VISION_MODEL=qwen/qwen3.8-27b
# reasoning_effort for the text model: auto (= low for gpt-oss, not sent for
# other models), none, low, medium, high. Never sent to the vision model.
AI_SECONDARY_REASONING_EFFORT=auto
# Optional smaller model at the same endpoint for the simple JSON workloads
# (ingredient prices, shopping-list tidy-up, weekly review prose), e.g.
# openai/gpt-oss-20b. Empty = AI_SECONDARY_MODEL for everything.
AI_SECONDARY_FAST_MODEL=

# Per-workload provider chains: gemini, groq, cloudflare, joined by ">" (first serves,
# the next retries on capacity/quota/413 errors). Empty = today's defaults:
#   MEAL_PLAN, SWAP, CHEFERIZE, IMPORT_TEXT, REVIEW = gemini>groq
#   CHAT, PRICES, SHOPPING = groq>gemini;  VISION = gemini
#   (AI_FREE_ONLY=true: every workload = groq>cloudflare)
# groq first on MEAL_PLAN = per-day chunked plans. Runbook for moving a
# workload off Gemini: docs/ai-providers.md.
AI_ROUTE_MEAL_PLAN=
AI_ROUTE_SWAP=
AI_ROUTE_CHEFERIZE=
AI_ROUTE_IMPORT_TEXT=
AI_ROUTE_VISION=
AI_ROUTE_CHAT=
AI_ROUTE_REVIEW=
AI_ROUTE_PRICES=
AI_ROUTE_SHOPPING=

# Shadow mode: replay a sampled share of premium, consented user calls on a
# candidate chain in the background and log "[ai.shadow]" scores, e.g.
# AI_SHADOW_ROUTE=mealPlan:groq and AI_SHADOW_SAMPLE=0.1. Off by default.
AI_SHADOW_ROUTE=
AI_SHADOW_SAMPLE=0

# ── Video-link recipe import ─────────────────────────────────────────────────
# Reads a YouTube/TikTok/Instagram video's caption, subtitles or speech (never
# its frames). Needs yt-dlp + ffmpeg on PATH (in the Docker image; locally
# `brew install yt-dlp ffmpeg`). Speech uses Whisper at AI_SECONDARY_BASE_URL
# with AI_SECONDARY_API_KEY (unset = no speech step). AI_MOCK_ENABLED=true
# uses a canned transcript instead of yt-dlp/Whisper.
WHISPER_MODEL=whisper-large-v3-turbo
VIDEO_MAX_SECONDS=600
VIDEO_MAX_DOWNLOAD_MB=50

# ── Cloudinary (optional recipe image CDN) ───────────────────────────────────
# Optional — only used with IMAGE_STORAGE=cloudinary (and `pnpm upload:images`).
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recipe images: pollinations (default, anonymous) or cloudflare (Workers AI).
# cloudflare needs ONLY an account id + API token with the "Workers AI"
# permission: the image bytes are stored on this server (uploads/recipes/,
# served at /uploads/recipes/* — the same volume as user photos).
IMAGE_PROVIDER=pollinations
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Workers AI as a TEXT provider ("cloudflare" in the routes above) — used only
# when AI_FREE_ONLY=true or a route names cloudflare; the keys alone (for
# images) change no text routing. Same account + token.
CF_TEXT_MODEL=@cf/openai/gpt-oss-120b
# Photos. Gemma 4 (Apache 2.0); not Llama 3.2/4 Vision, whose licence
# withholds the multimodal models from EU-based developers.
CF_VISION_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional cheaper model for prices/shopping/review, e.g. @cf/openai/gpt-oss-20b.
CF_FAST_MODEL=
# Text stops going to Workers AI once today's neurons (text + images, per UTC
# day, in memory — a restart resets the count) reach this; images keep the
# rest of the free 10,000/day.
CF_TEXT_NEURON_BUDGET=8000
# Where generated image bytes go: local (default) or cloudinary (needs the
# CLOUDINARY_* keys above).
IMAGE_STORAGE=local
# Public origin for stored-image URLs. Leave empty: production uses APP_URL
# (single origin), dev uses http://localhost:3001.
API_PUBLIC_URL=

# ── Unsplash (ingredient images) ─────────────────────────────────────────────
# Optional — without this key, ingredient images fall back to category images.
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: mock | resend | smtp. Unset keeps the legacy switch —
# EMAIL_MOCK_ENABLED=true (default) logs emails (incl. password-reset links) to
# the API console instead of sending; false sends through Resend.
EMAIL_PROVIDER=
EMAIL_MOCK_ENABLED=true
# Resend: the shared onboarding@resend.dev sender only delivers to the Resend
# account owner's inbox — use a verified-domain EMAIL_FROM for real users.
RESEND_API_KEY=
# Unset: the SMTP_USER address for smtp, else "Chefer <onboarding@resend.dev>".
EMAIL_FROM=
# SMTP (EMAIL_PROVIDER=smtp) — defaults target Gmail over TLS. For Gmail,
# SMTP_PASS is an App Password (myaccount.google.com/apppasswords, needs
# 2-Step Verification) and EMAIL_FROM must be SMTP_USER or a verified alias.
# See "Sending email from Gmail" in infrastructure.md §10.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Max sends per rolling 24h (default 400 for smtp — Gmail allows ~500/day;
# none otherwise). Weekly emails stop 50 short; reset/confirmation never do.
EMAIL_DAILY_CAP=
# Base URL used in emailed links
APP_URL=http://localhost:3000
# Signs weekly-email unsubscribe + email-confirmation links (min 32 chars).
# Optional: unset derives a key from JWT_SECRET. Set it in production so
# rotating JWT_SECRET doesn't break unsubscribe links already in inboxes.
# EMAIL_TOKEN_SECRET=

# ── Stripe (Phase 5) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
