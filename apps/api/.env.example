# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chefer_dev

# Auth / JWT
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── AI (Chefer) ───────────────────────────────────────────────────────────────
# Set AI_MOCK_ENABLED=true locally — no real LLM calls, no token spend.
# Set AI_MOCK_ENABLED=false to use a real AI provider (set the key below too).
AI_MOCK_ENABLED=true
AI_MOCK_DELAY_MS=0

# Which provider to use when AI_MOCK_ENABLED=false.
# Options: gemini (primary, with optional failover) | openai (secondary standalone)
AI_PROVIDER=gemini

# Gemini (free tier — get key at https://aistudio.google.com)
# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model names (defaults shown) — change to move models without a code change.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Secondary OpenAI-compatible provider (free-tier failover, premium_plan.md §5.5).
# With AI_PROVIDER=gemini: setting AI_SECONDARY_API_KEY enables automatic
# failover on Gemini capacity/quota errors + secondary-first routing for cheap
# high-volume calls (chat, ingredient prices, shopping list). Leave empty to
# run Gemini alone. Vision (meal-photo scan, photo import) is ALWAYS
# Gemini-only — the default secondary model has no image input.
# Defaults target Groq's free tier (key at https://console.groq.com).
AI_SECONDARY_API_KEY=
AI_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
AI_SECONDARY_MODEL=openai/gpt-oss-120b

# ── Cloudinary (recipe image hosting) ────────────────────────────────────────
# Optional — image generation will fail gracefully without these.
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recipe images: pollinations (default, anonymous) or cloudflare (Workers AI,
# uploaded to Cloudinary above). cloudflare needs an account id + API token
# with the "Workers AI" permission.
IMAGE_PROVIDER=pollinations
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ── Unsplash (ingredient images) ─────────────────────────────────────────────
# Optional — without this key, ingredient images fall back to category images.
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Mock is on by default: emails (incl. password-reset links) log to the API
# console instead of sending. Set EMAIL_MOCK_ENABLED=false + RESEND_API_KEY
# to send real mail. The default shared sender only delivers to the Resend
# account owner's inbox — use a verified-domain EMAIL_FROM for real users.
EMAIL_MOCK_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM="Chefer <onboarding@resend.dev>"
# Base URL used in emailed links
APP_URL=http://localhost:3000

# ── Stripe (Phase 5) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
