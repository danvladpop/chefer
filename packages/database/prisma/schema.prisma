// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev. The production image is Alpine (musl) with
  // OpenSSL 3 — "native" alone resolves to the OpenSSL 1.1 musl engine there
  // and fails at runtime with `libssl.so.1.1: No such file`. Both musl
  // OpenSSL-3 engines are listed so the image works on x86_64 and ARM64 VMs.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  ATHLETE
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  EAT_HEALTHIER
  // §2.11, T-11.1 (rev 2). Additive — no old value removed/renamed. Old
  // clients that render a fixed GOALS list never receive these directly:
  // for requests without x-chefer-api-level >= 1, the API serialises
  // RECOMP/PERFORMANCE as MAINTAIN in chefProfile.goal (the true value is
  // in the new goalV2 the API layer adds).
  RECOMP
  PERFORMANCE
}

enum RecipeSource {
  AI
  MANUAL
  CURATED
}

enum ImageStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}

enum MealPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// "What brings you here?" — onboarding step 0 (backlog P2-3, audit F-PM-6).
// Routes each audience to its first screen; stored for per-audience metrics.
enum OnboardingIntent {
  EAT_BETTER
  HOUSEHOLD
  TRAIN
}

// §2.4, T-03.1 (rev 2 adds TRACK). Superset of OnboardingIntent — replaces
// it for new clients; effectiveJobs() (@chefer/utils) maps a legacy intent
// onto this set on read, so nothing needs a backfill.
enum OnboardingJob {
  TRAIN
  PLAN_MEALS
  HOUSEHOLD
  USE_WHAT_I_HAVE
  SAVED_RECIPES
  TRACK
}

// §2.11, T-35.1/T-11.1 (rev 2). Whether a user's daily targets are the
// system's SUGGESTED numbers or their own OWN override.
enum TargetMode {
  SUGGESTED
  OWN
}

// §2.11, T-11.1 (rev 2). A TargetChange row's kind: CHANGED = the effective
// numbers already moved (applies at once, reversible via acknowledgeChange);
// SUGGESTED = a proposal awaiting acceptance (e.g. the coach's review).
enum TargetChangeKind {
  CHANGED
  SUGGESTED
}

// §2.13, T-39.1-39.5 (rev 2). Every consent Chefer records, in one
// append-only log — the source of truth the User.*ConsentAt cache columns
// are read back from.
enum ConsentKind {
  TERMS
  PRIVACY
  AGE
  AI
  ANALYTICS_ANON
  ANALYTICS_LINKED
  EMAIL_WEEK_READY
  EMAIL_RECAP
  AUTO_PLAN
  HEALTH
  // Following (docs/friends/implementation-plan.md §2.1): turn-on, visibility
  // and targets-sharing consent; withdrawn on Turn off (PRD FD-14).
  SOCIAL_SHARING
}

enum AiCallType {
  MEAL_PLAN
  RECIPE_SWAP
  SHOPPING_LIST
  IMAGE_GENERATION
  INGREDIENT_PRICES
  CHAT
  SCAN
  RECIPE_IMPORT
  // S17, rev 2: curated-plan imports, counted as "used" only when saved
  // (display only — see Q-18 in the technical plan).
  CURATED_PLAN
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  emailVerified            DateTime?
  name                     String?
  firstName                String?
  lastName                 String?
  image                    String?
  role                     UserRole  @default(USER)
  planTier                 PlanTier  @default(FREE)
  passwordHash             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  // Weekly emails (audit P2-5, F-PM-14): Monday "your week is ready" and the
  // Sunday recap. Opt-out, per email — the signed unsubscribe link or the
  // Preferences toggles flip them. Only sent to a confirmed address.
  // S15, rev 2: default flipped to false for NEW rows only (`db push` only
  // changes the column default — existing accounts keep their value, T-39.3).
  // Registration writes the three email/auto-plan defaults explicitly and
  // logs them (ConsentService); existing accounts get a one-time card
  // tracked by emailDefaultsNoticeAt below.
  weeklyEmailReady         Boolean   @default(false)
  weeklyEmailRecap         Boolean   @default(false)
  // AI data consent (App Store 5.1.2(i)): when the user allowed Chefer to send
  // their data to the third-party AI provider. Null = not asked yet / revoked;
  // clients show the consent sheet before the first AI action. User-initiated
  // procedures are gated client-side only; background AI jobs (weekly
  // auto-plan, coach review wording) skip users without consent.
  aiDataConsentAt          DateTime?
  // Health-data consent (§2.8, T-26.1) — a cache of the latest HEALTH
  // ConsentEvent, read by the (wave-1) consent middleware without a join.
  // Null = not given / withdrawn. The withdrawal event itself is the audit
  // trail (rev 2 drops a separate healthDataWithdrawnAt column).
  healthDataConsentAt      DateTime?
  healthDataConsentVersion String?
  // S15, rev 2: one-time notice for existing accounts whose email defaults
  // silently became explicit values (never re-shown once set).
  emailDefaultsNoticeAt    DateTime?
  // S15, rev 2: cache of the terms/privacy version last accepted (the log
  // entry is the source of truth, ConsentEvent kind TERMS).
  termsAcceptedVersion     String?

  // Relations
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  profile              UserProfile?
  chefProfile          ChefProfile?
  dietaryPreferences   DietaryPreferences?
  mealPlans            MealPlan[]
  favouriteRecipes     FavouriteRecipe[]
  mealRatings          MealRating[]
  dailyLogs            DailyLog[]
  weightEntries        WeightEntry[]
  createdRecipes       Recipe[]              @relation("CreatedRecipes")
  aiCallLogs           AiCallLog[]
  chefReviews          ChefReview[]
  householdMembers     HouseholdMember[]
  pantryItems          PantryItem[]
  feedback             Feedback[]
  customExercises      Exercise[]
  gymProfile           GymProfile?
  routines             Routine[]
  workoutSessions      WorkoutSession[]
  exerciseProgressions ExerciseProgression[]
  trainingPauses       TrainingPause[]
  emailSends           EmailSend[]
  // S3, S12, S14 (wave 0, T-00.10)
  safetyReports        SafetyReport[]
  targetChanges        TargetChange[]
  consentEvents        ConsentEvent[]

  // Following (docs/friends/implementation-plan.md §2.3)
  socialProfile         SocialProfile?
  followsOut            Follow[]              @relation("FollowsOut")
  followsIn             Follow[]              @relation("FollowsIn")
  blocksMade            Block[]               @relation("BlocksMade")
  blocksReceived        Block[]               @relation("BlocksReceived")
  dismissalsMade        SuggestionDismissal[] @relation("DismissalsMade")
  dismissalsReceived    SuggestionDismissal[] @relation("DismissalsReceived")
  reportsMade           UserReport[]          @relation("ReportsMade")
  reportsReceived       UserReport[]          @relation("ReportsReceived")
  moderationLog         ModerationLog[]       @relation("ModerationTarget")
  notificationsReceived Notification[]        @relation("NotificationsReceived")
  notificationsCaused   Notification[]        @relation("NotificationsCaused")
  copiedRecipesOrigin   Recipe[]              @relation("RecipeOriginCreator")

  // Ingredient catalog (docs/plan-ingredient-catalog.md §3): the user's private ingredients
  privateIngredients Ingredient[]
  ingredientNotices  IngredientNotice[]

  @@index([email])
  @@map("users")
}

// Weekly-email send log (audit P2-5): one row per user, email kind and week,
// claimed BEFORE sending — @@unique makes a restart or a second worker tick a
// no-op, so nobody is emailed twice for the same week. kind: "WEEK_READY" |
// "WEEKLY_RECAP" (a string, so new kinds need no enum migration).
model EmailSend {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  weekStart DateTime // UTC midnight of the Monday of the week the email is about
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, weekStart])
  @@map("email_sends")
}

// Beta feedback channel (ux-fixes-plan.md 1.6): free-text notes from any
// signed-in user, tagged with the page they were on.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  path      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("feedback")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  website   String?
  location  String?
  twitter   String?
  github    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ChefProfile {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  displayName            String?
  biologicalSex          BiologicalSex?
  age                    Int?
  heightCm               Float?
  weightKg               Float?
  activityLevel          ActivityLevel?
  goal                   Goal?
  dailyCalorieTarget     Int?
  weeklyBudgetEur        Float?
  deliveryAddress        String?
  deliveryCurrency       String?           @default("EUR")
  preferredUnits         UnitSystem        @default(METRIC)
  // Adaptive Chef (F1): cumulative calorie dial applied by weekly reviews on
  // top of the computed TDEE target. resolveDailyTargets adds it AFTER the
  // goal adjustment; the protein cap runs last.
  targetAdjustmentKcal   Int               @default(0)
  // Premium Sunday auto-planning opt-out (audit F-PLAN-4-3). When off, the
  // WeeklyPlanWorker leaves the user's next week alone.
  // S16, rev 2: default flipped to false for NEW rows only (T-39.3) —
  // existing rows keep their value under `db push`.
  autoPlanWeekly         Boolean           @default(false)
  // Onboarding audience (backlog P2-3). Null = never answered (older users).
  onboardingIntent       OnboardingIntent?
  // S4, rev 2 (§2.4, T-03.1/T-04.1/T-06.9/T-21.1): the jobs the user is here
  // to do — superset of onboardingIntent for new clients. [] = never
  // answered; effectiveJobs() maps the legacy intent on read, no backfill.
  onboardingJobs         OnboardingJob[]   @default([])
  // The onboarding answer for which weekdays the user trains — used only
  // until an active routine has planned weekdays of its own.
  trainingWeekdays       Int[]             @default([])
  // Null = derive from goal (bug B-31); explicit true/false overrides it.
  showNutritionOnToday   Boolean?
  // §2.6, rev 2 (UX-06): weekday -> 'lift' | 'run' | 'long_run' | 'rest'
  // (dayKindSchema, @chefer/types). `lift` days come from the routine; the
  // others are set by training.setDayKinds (wave 1).
  trainingDayKinds       Json              @default("{}")
  // IANA time zone (§2.12, T-21.1), for server-initiated work (the weekly
  // worker, the quiet-days nudge text) — set once by setDisplayPreferences.
  timeZone               String?
  // §2.11, rev 2 (T-35.1, T-11.1): own-target override.
  targetMode             TargetMode        @default(SUGGESTED)
  customKcal             Int?
  customProteinG         Int?
  customCarbsG           Int?
  customFatG             Int?
  customTrainingKcal     Int?
  customTrainingProteinG Int?
  addTrainingBonus       Boolean           @default(true)
  // The last { effective, suggested, inputs } the user saw — read-detection
  // for "never change targets silently" (§2.11). The first read after
  // deploy writes a baseline with no notice.
  targetSnapshot         Json?
  // S10 (T-10.4): only used if D-7 = yes. Unused this wave — no code reads
  // it yet; the field lands now because no later wave touches schema.prisma.
  freeScaledWeekStart    DateTime?
  updatedAt              DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chef_profiles")
}

model DietaryPreferences {
  id                    String    @id @default(cuid())
  userId                String    @unique
  cuisinePreferences    String[]
  dietaryRestrictions   String[]
  allergies             String[]
  dislikedIngredients   String[]
  mealsPerDay           Int       @default(3)
  // Legacy "cooking for N" (backlog P2-3, audit F-PM-8): the household is the
  // one people model now. A value > 1 is converted into placeholder members
  // once (HouseholdService.migrateLegacyServingSize) and reset to 1; reads
  // derive it from the household for app builds already in the stores.
  servingSize           Int       @default(1)
  // §2.3, T-07.1 (S1): plan shape, next to mealsPerDay which it supersedes
  // for new clients. [] = legacy (breakfast/lunch/dinner, every day, no cap)
  // — an existing user who never opens the form gets the same week.
  planSlots             String[]  @default([])
  planDays              Int[]     @default([])
  timeCapMins           Int?
  weekendNoLimit        Boolean   @default(false)
  cookingFor            Int?
  // Persists "cook once, eat twice" (bug B-27).
  leftovers             Boolean   @default(false)
  // §2.1, T-01.3/T-01.9 (S2, rev 2): null + any stored term that isn't a
  // canonical taxonomy label => tableSafety.needsReview.
  safetyReviewedAt      DateTime?
  excludeLabelDependent Boolean   @default(false)
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dietary_preferences")
}

model Recipe {
  id            String       @id @default(cuid())
  name          String
  description   String
  ingredients   Json // { name: string, quantity: number, unit: string }[]
  instructions  String[]
  nutritionInfo Json // { calories: number, protein: number, carbs: number, fat: number, fiber: number }
  cuisineType   String
  dietaryTags   String[]
  prepTimeMins  Int
  cookTimeMins  Int
  servings      Int
  imageUrl      String?
  imageStatus   ImageStatus  @default(DONE)
  imageRetries  Int          @default(0)
  imagePriority Int          @default(100) // lower = generated first (0 = today)
  source        RecipeSource @default(AI)
  sourceUrl     String? // Cheferize (F5): provenance of imported recipes
  creatorId     String?
  createdAt     DateTime     @default(now())

  creator     User?             @relation("CreatedRecipes", fields: [creatorId], references: [id])
  favourites  FavouriteRecipe[]
  mealRatings MealRating[]

  // Following (docs/friends/implementation-plan.md §2.3)
  /// Set on a viewer's private copy of another user's recipe (made by "Add to my week", PRD §13).
  originRecipeId  String?
  originCreatorId String?
  /// Automatic moderation (PRD §9): hidden from everyone but the creator; existing hearts and copies keep working.
  hiddenAt        DateTime?
  hiddenReason    RecipeHiddenReason?
  /// UX-REC-04: the owner's soft delete (`recipe.deleteMine`). Hidden from lists, pickers, pins and sharing; slots in the owner's existing plans keep resolving it (a tombstone). Null = live.
  deletedAt       DateTime?

  originRecipe  Recipe?  @relation("RecipeCopies", fields: [originRecipeId], references: [id], onDelete: SetNull)
  copies        Recipe[] @relation("RecipeCopies")
  originCreator User?    @relation("RecipeOriginCreator", fields: [originCreatorId], references: [id], onDelete: SetNull)

  // Ingredient catalog (docs/plan-ingredient-catalog.md §3, additive). `ingredients`
  // (Json) stays as the {name, quantity, unit} mirror of `lines`, written in the
  // same transaction by writeRecipeLines. Until a recipe is migrated (§7) it has
  // no lines and stays PARTIAL.
  nutritionStatus     NutritionStatus    @default(PARTIAL)
  nutritionComputedAt DateTime?
  /// Whole-recipe totals (same shape as nutritionInfo), kept for audit.
  nutritionTotal      Json?
  lines               RecipeIngredient[]

  // At most one copy per viewer and source. NOT a @@unique: adding a unique
  // constraint to the populated `recipes` table makes `prisma db push` stop
  // with a data-loss warning (production's migrate service runs it without
  // --accept-data-loss), so RecipeCopyService enforces it with a SERIALIZABLE
  // find-or-create over this index instead.
  @@index([creatorId, originRecipeId])
  @@index([creatorId])
  @@index([creatorId, source, createdAt])
  @@map("recipes")
}

model FavouriteRecipe {
  id            String   @id @default(cuid())
  userId        String
  recipeId      String
  savedAt       DateTime @default(now())
  useInNextPlan Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("favourite_recipes")
}

/// How a week's plan came to exist (audit F-PLAN-4-1/4-2). The Sunday worker
/// may replace an untouched CARRY_FORWARD copy with a fresh week; anything
/// else is the user's and is left alone. Only WEEKLY_AUTO shows the Monday
/// "the chef prepared this week" banner.
enum MealPlanOrigin {
  USER // generated, restored or built by the user
  CARRY_FORWARD // lazy copy of the latest week when a new week is first viewed
  TEMPLATE // a followed "My weeks" template applied to a week
  WEEKLY_AUTO // generated by the Sunday worker
}

model MealPlan {
  id            String         @id @default(cuid())
  userId        String
  weekStartDate DateTime
  status        MealPlanStatus @default(DRAFT)
  origin        MealPlanOrigin @default(USER)
  createdAt     DateTime       @default(now())
  // Week templates ("My weeks"): named saved weeks the user rotates through
  // (capped at 4 in the service). Templates never appear in week/history
  // queries; at most one has isFollowed=true — carry-forward clones it.
  isTemplate    Boolean        @default(false)
  name          String?
  isFollowed    Boolean        @default(false)

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      MealPlanDay[]
  // Instant week, then live tailoring (premium): the background job that
  // replaces this plan's curated days with AI days, one at a time.
  tailoring MealPlanTailoring?

  @@index([userId])
  @@index([userId, isTemplate])
  @@map("meal_plans")
}

enum MealPlanTailoringStatus {
  RUNNING // days still queued for the chef
  DONE // every queued day was tailored (or kept because the user changed it)
  PARTIAL // stopped early (capacity, failures, shopping started) — the rest stay curated
  FAILED // stopped before any day could be tailored
  CANCELLED // superseded by a newer generation, or the plan stopped being current
}

// Premium "instant week, then the chef tailors it live": generate returns a
// complete curated week at once and queues this job; PlanTailoringWorker
// claims it (lease), asks the AI for ONE day at a time (today first) and
// swaps that day's meals in. The job is durable (DB-polled), so it survives
// restarts; deleting the plan deletes it (cascade).
model MealPlanTailoring {
  id                  String                  @id @default(cuid())
  planId              String                  @unique
  userId              String
  status              MealPlanTailoringStatus @default(RUNNING)
  // Days the job set out to tailor (planned days from today on).
  totalDays           Int
  // Days still to do, in order (today first, then the following days).
  queuedDays          Int[]
  tailoredDays        Int[]
  // Left alone because the user changed or logged them after generation.
  keptDays            Int[]
  // The AI could not produce a usable day — the curated day stays.
  failedDays          Int[]
  currentDay          Int?
  // { "<dayOfWeek>": PlanMealSlotJson[] } as generated — a day that no longer matches was touched.
  snapshots           Json
  // Shopping-list ticks at queue time; a new tick means the user started shopping.
  baselineCheckedKeys String[]
  // Meal types a tailored day may contain (the plan shape at generation).
  slotTypes           String[]
  leftovers           Boolean                 @default(false)
  // Consecutive failures (capacity errors back off and retry the same day).
  strikes             Int                     @default(0)
  // "Tailor the rest" re-queues (capped; no new quota reservation).
  resumes             Int                     @default(0)
  nextRunAt           DateTime                @default(now())
  // Claim lease — a crashed worker's job is picked up again once it lapses.
  leaseUntil          DateTime?
  lastError           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  finishedAt          DateTime?

  plan MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("meal_plan_tailorings")
}

model MealPlanDay {
  id         String @id @default(cuid())
  mealPlanId String
  dayOfWeek  Int // 0 = Monday … 6 = Sunday
  meals      Json // { type: "breakfast"|"lunch"|"dinner"|"snack", recipeId: string }[]

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@map("meal_plan_days")
}

model MealRating {
  id       String   @id @default(cuid())
  userId   String
  recipeId String
  rating   Int // 1–5 stars
  notes    String?
  ratedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("meal_ratings")
}

model DailyLog {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  loggedMeals  Json
  totalKcal    Int
  totalProtein Float
  totalCarbs   Float
  totalFat     Float
  // WP-06: plan slots the user skipped that day — [{ mealType, slotIndex }].
  // Deliberately NOT part of loggedMeals: shipped clients iterate the entries
  // and sum them, and a skipped meal is not food. Additive, defaults to [].
  skippedSlots Json     @default("[]")
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_logs")
}

// The Adaptive Chef (F1): one row per user-week, written idempotently by the
// Sunday review pass BEFORE plan generation. adjustmentKcal is the delta this
// review applied; the cumulative dial lives in ChefProfile.targetAdjustmentKcal.
model ChefReview {
  id                     String    @id @default(cuid())
  userId                 String
  weekStart              DateTime // UTC midnight of the reviewed week's Monday
  adherencePct           Int
  avgDailyKcal           Int
  weightTrendKg          Float? // EWMA delta over the window; null until enough data
  adjustmentKcal         Int
  savedEur               Float? // pantry savings surfaced in the review (F3 seam)
  reviewText             String
  createdAt              DateTime  @default(now())
  // §2.11, T-35.4 (S13, rev 2): the coach proposes, never overwrites —
  // adjustmentKcal keeps meaning "applied" (0 until accepted); the proposal
  // surfaces as a SUGGESTED TargetChange until acknowledged.
  proposedAdjustmentKcal Int?
  proposalResolvedAt     DateTime?
  // App Review R-14 (Guideline 1.4.1 / EU AI Act Art. 50): true when the review
  // prose came from the AI model, false for the deterministic template. Rows
  // written before this column existed read false (unlabelled) until the next
  // weekly review replaces them.
  aiGenerated            Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("chef_reviews")
}

// §2.1, T-01.5 (S3, wave 0 T-00.10). A "report this recipe" flag — part of
// the safety table itself: SafetyService.loadTable includes the user's
// reported recipe ids and filter() removes them (UX-01 d). Included in
// exportData; the cascade on user covers deleteAccount.
model SafetyReport {
  id            String   @id @default(cuid())
  userId        String
  recipeId      String
  surface       String // where it was reported from, e.g. "recipe_detail", "cook_mode"
  reason        String
  note          String? // <= 500 chars, validated at the zod layer
  rulesSnapshot Json // the table-safety rules in force when reported
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@map("safety_reports")
}

// §2.11, T-11.1 (S12, rev 2). "Never change your targets silently" made
// provable: every detected change or proposal is one row here. Auto-resolves
// after 14 days (lazy, on read) when never acknowledged. Included in exportData.
model TargetChange {
  id         String           @id @default(cuid())
  userId     String
  kind       TargetChangeKind
  reason     String
  fields     Json // { field, before, after }[]
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  resolution String? // "USE_NEW" | "KEEP_OLD" | "AUTO"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resolvedAt])
  @@map("target_changes")
}

// §2.13, T-39.1-39.5 (S14, rev 2). Append-only consent log — the source of
// truth every `User.*ConsentAt` cache column is refreshed from, in the same
// transaction as the write. Never updated.
model ConsentEvent {
  id              String      @id @default(cuid())
  userId          String
  kind            ConsentKind
  granted         Boolean
  providers       String[]    @default([])
  documentVersion String?
  source          String // "web" | "mobile" | "migration"
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("consent_events")
}

// Feed the Whole Table (F2): extra eaters merged into generation. Safety
// fields are unioned with the owner's before recipe filtering.
model HouseholdMember {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  portionFactor       Float    @default(1) // 0.5 kid … 1.5 big eater
  isKid               Boolean  @default(false)
  allergies           String[] @default([])
  dietaryRestrictions String[] @default([])
  dislikedIngredients String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("household_members")
}

// Zero-Waste Kitchen (F3): what the user already has. Seeded from shopping
// list check-offs (source PURCHASE) or added by hand (MANUAL).
model PantryItem {
  id             String   @id @default(cuid())
  userId         String
  ingredientName String // normalized (normalizeIngredientName)
  quantity       Float
  unit           String
  source         String   @default("PURCHASE") // PURCHASE | MANUAL
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientName, unit])
  @@index([userId])
  @@map("pantry_items")
}

model WeightEntry {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("weight_entries")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String?    @db.Text
  excerpt     String?
  coverImage  String?
  published   Boolean    @default(false)
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags   PostTag[]

  @@index([authorId])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model AiCallLog {
  id        String     @id @default(cuid())
  userId    String
  callType  AiCallType
  createdAt DateTime   @default(now())
  // S17, rev 2 (T-39.5, T-10.8): null for historic rows.
  provider  String?
  saved     Boolean?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_call_logs")
}

model IngredientImage {
  ingredientName String   @id
  imageUrl       String
  resolvedAt     DateTime @default(now())

  @@map("ingredient_images")
}

// The ingredient catalog / "vocabulary": store-agnostic baseline prices AND
// per-100g macros, per base-unit family so recipe quantities can be scaled
// (250 g spinach = 2.5 × pricePer100gEur). Refreshed periodically by
// IngredientPriceWorker (source AI_ESTIMATE). Rows with creatorId are a
// user's private custom ingredients (source USER, never AI-refreshed).
model IngredientPrice {
  ingredientName   String      @id // normalized lowercase
  pricePer100gEur  Float?
  pricePer100mlEur Float?
  pricePerPieceEur Float?
  // Macros per 100 g — drive auto-computed recipe nutrition
  caloriesPer100g  Float?
  proteinPer100g   Float?
  carbsPer100g     Float?
  fatPer100g       Float?
  fiberPer100g     Float?
  // Count-unit → grams conversion ("1 medium banana ≈ 118 g")
  gramsPerPiece    Float?
  imageUrl         String?
  creatorId        String? // null = global vocabulary; set = private custom ingredient
  source           String      @default("AI_ESTIMATE")
  estimatedAt      DateTime    @default(now())
  /// Catalog row this price belongs to (plan-ingredient-catalog §3). The macro
  /// columns above are deprecated: new code reads nutrition from Ingredient.
  ingredientId     String?
  ingredient       Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([ingredientId])
  @@map("ingredient_prices")
}

// ─── Ingredient catalog (docs/plan-ingredient-catalog.md §3) ──────────────────
// Global rows (ownerId null) come only from packages/database/data/ingredients/
// catalog.json via the sync script; private rows (ownerId set) are user-created
// and visible to their owner only. Postgres treats NULLs as distinct, so the
// [ownerId, slug] / [ownerId, alias] uniques do NOT stop two global rows from
// sharing a slug or alias: the catalog validators and the sync enforce that.

enum IngredientStatus {
  ACTIVE
  MERGED
  DEPRECATED
}

enum IngredientNoticeKind {
  /// "N of your ingredients now use Chefer's verified data" (D6)
  VERIFIED_DATA
  /// "Please check this ingredient": a REJECT_DATA review decision
  CHECK_DATA
}

/// In-app notices from the weekly ingredient review (plan-ingredient-catalog §8.2, D6).
/// One row per (user, kind, review): re-applying a review updates it in place.
model IngredientNotice {
  id              String               @id @default(cuid())
  userId          String
  kind            IngredientNoticeKind
  /// The review's date, "2026-10-08"
  review          String
  /// Display names of the ingredients concerned (the user's own names)
  ingredientNames String[]
  createdAt       DateTime             @default(now())
  readAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, review])
  @@index([userId, readAt])
  @@map("ingredient_notices")
}

enum NutritionSource {
  USDA_FDC
  CIQUAL
  LABEL
  USER
  ADMIN
}

enum NutritionStatus {
  COMPUTED
  PARTIAL
  USER_ENTERED
}

enum IngredientCategory {
  VEGETABLE
  FRUIT
  HERB_FRESH
  SPICE_DRIED
  LEGUME
  GRAIN_CEREAL
  FLOUR_BAKING
  PASTA_NOODLE
  BREAD_BAKERY
  NUT_SEED
  BEEF
  PORK
  LAMB_GOAT
  POULTRY
  GAME
  PROCESSED_MEAT
  FISH
  SEAFOOD
  EGG
  DAIRY_MILK
  DAIRY_CHEESE
  DAIRY_YOGURT_CREAM
  PLANT_PROTEIN
  PLANT_MILK
  OIL_FAT
  CONDIMENT_SAUCE
  VINEGAR
  SWEETENER
  CANNED_JARRED
  PICKLED_FERMENTED
  STOCK_BROTH
  BEVERAGE
  ALCOHOL_COOKING
  SUPPLEMENT
  SNACK_PREPARED
  OTHER
}

model Ingredient {
  id              String             @id @default(cuid())
  /// "chicken-breast-raw"; unique among globals (enforced by sync + validators, see above)
  slug            String
  /// Display name: "Chicken breast, raw"
  name            String
  category        IngredientCategory
  status          IngredientStatus   @default(ACTIVE)
  /// Set when MERGED (a private row relinked to a global one by the weekly review)
  mergedIntoId    String?
  /// null = global; set = private to that user
  ownerId         String?
  // Nutrition per 100 g EDIBLE portion, EU convention (carbs exclude fiber, D2)
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float
  sugarPer100g    Float?
  satFatPer100g   Float?
  sodiumMgPer100g Float?
  // Conversion
  /// Required when the ingredient may be measured by volume
  densityGPerMl   Float?
  /// < 1 only for bone-in / unpeeled purchase-weight rows
  edibleFraction  Float              @default(1)
  // Provenance
  nutritionSource NutritionSource
  /// "fdc:171077", "ciqual:12345", "label:<url>"
  sourceRef       String?
  sourceNote      String?
  imageUrl        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner      User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mergedInto Ingredient?         @relation("IngredientMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Ingredient[]        @relation("IngredientMerges")
  aliases    IngredientAlias[]
  portions   IngredientPortion[]
  lines      RecipeIngredient[]
  prices     IngredientPrice[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([status])
  @@map("ingredients")
}

/// Normalized lookup keys → ingredient (plan §6.1 normalization).
model IngredientAlias {
  id           String     @id @default(cuid())
  ingredientId String
  alias        String
  /// "en" | "ro"
  locale       String     @default("en")
  /// null for global aliases; the private ingredient's owner otherwise
  ownerId      String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ownerId, alias])
  @@index([alias])
  @@index([ingredientId])
  @@map("ingredient_aliases")
}

/// Count / household unit → edible grams for ONE unit, per ingredient.
model IngredientPortion {
  id           String     @id @default(cuid())
  ingredientId String
  /// Canonical portion unit: "piece", "medium", "clove", "slice", "can", …
  unit         String
  grams        Float
  /// "fdc-portion:<id>", "label", "admin", "user"
  source       String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, unit])
  @@map("ingredient_portions")
}

/// One recipe line, linked to a catalog row. Recipe.ingredients (Json) mirrors these.
model RecipeIngredient {
  id           String      @id @default(cuid())
  recipeId     String
  position     Int
  /// null only for unresolved lines (legacy / old-client names, or a deleted private row)
  ingredientId String?
  /// What the author, AI or importer wrote; never lost
  rawName      String
  quantity     Float
  /// Canonical unit (plan §5.1)
  unit         String
  /// Resolved edible grams; null ⇒ line unresolved
  grams        Float?
  /// Prep text: "minced", "diced", "drained"
  note         String?
  /// Garnish / "to serve": excluded from totals
  optional     Boolean     @default(false)
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict: deleting an account cascades its private ingredients,
  // and a line that pointed at one must become unresolved, not block the delete.
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// Persisted (AI-consolidated) shopping list for a meal plan. Written by
// shoppingList.regenerate so the Gemini result survives reloads; getForWeek
// serves it when present.
model ShoppingList {
  id          String   @id @default(cuid())
  planId      String   @unique
  items       Json // ShoppingListItemForWeek[] minus images/prices (re-resolved)
  aiGenerated Boolean  @default(false)
  checkedKeys String[] @default([]) // synced check-off state (P1-5)
  customItems Json     @default("[]") // user-added items overlaying the derived list (chat tool + manual add)
  updatedAt   DateTime @updatedAt

  @@map("shopping_lists")
}

model CarrefourPriceCache {
  ingredientName String   @id
  productName    String
  priceRon       Float
  resolvedAt     DateTime @default(now())

  @@map("carrefour_price_cache")
}

// ─── Gym (gym_plan.md §2) ─────────────────────────────────────────────────────
// Weights are kg (Float, 0.01 precision) and rendered in GymProfile.unit.
// Anything a phone creates offline (sessions, session exercises, sets) uses a
// CLIENT-generated UUID id so the sync upsert is idempotent. ExerciseProgression
// is a derived cache: always recomputable by folding the engine
// (@chefer/utils gym/progression) over completed sessions.

enum ExerciseEquipment {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  BODYWEIGHT
  SMITH
  EZ_BAR
  KETTLEBELL
  BAND
  ASSISTED
  // S19 (T-42.0, 06 §5.3) — cardio equipment. Never sent to a level < 2
  // client (Δ2.1); the custom form only offers them on level-2 builds.
  TREADMILL
  BIKE
  ROWER
  ELLIPTICAL
  STAIR_CLIMBER
  SKI_ERG
  ASSAULT_BIKE
  JUMP_ROPE
  POOL
  OUTDOOR
}

// S18 (T-42.0, 06 §5.1) — cardio-as-first-class-type. All six land at once;
// INTERVALS is unused until W5. Additive: old clients never receive a
// non-WEIGHT_REPS/BODYWEIGHT_REPS/DURATION exercise (Δ2.1 renderableTrackingTypes).
enum ExerciseTrackingType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  DURATION
  DURATION_DISTANCE
  DISTANCE
  INTERVALS
}

// S21 (T-42.0) — GymProfile.distanceUnit. Null = derived from `unit`
// (Δ2.2: MI when unit = LB, else KM).
enum DistanceUnit {
  KM
  MI
}

enum ExerciseLoadType {
  WEIGHTED
  BODYWEIGHT
  BODYWEIGHT_PLUS
  ASSISTED
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
}

enum GymEquipmentAccess {
  FULL_GYM
  DUMBBELLS
  BODYWEIGHT
}

enum WeightUnit {
  KG
  LB
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
  DISCARDED
}

model Exercise {
  id               String               @id // curated: stable slug; custom: cuid
  ownerId          String? // null = curated (shared by everyone)
  name             String
  aliases          String[]
  category         ExerciseCategory
  movementPattern  String
  equipment        ExerciseEquipment
  loadType         ExerciseLoadType
  primaryMuscles   String[]
  secondaryMuscles String[]
  repMin           Int
  repMax           Int
  restSec          Int
  incrementKg      Float
  perHand          Boolean              @default(false)
  isLowerBody      Boolean              @default(false)
  isTimed          Boolean              @default(false) // reps fields hold SECONDS (plank, carries)
  // S18 (T-42.0): additive. `isTimed` stays and is still written (true for
  // every time-based type) so a level-0/1 client keeps its seconds label.
  // Boot backfill (Δ2.2): customs with isTimed → DURATION, loadType
  // BODYWEIGHT → BODYWEIGHT_REPS.
  trackingType     ExerciseTrackingType @default(WEIGHT_REPS)
  swapGroup        String?
  cues             String[]
  mistakes         String[]
  blurb            String?
  imageKeys        String[]
  videoId          String?
  videoStartSec    Int?
  videoChannel     String?
  contentVersion   Int                  @default(1)
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
  sessionExercises SessionExercise[]

  @@index([ownerId])
  @@index([updatedAt])
  @@map("exercises")
}

model GymProfile {
  userId            String             @id
  experience        TrainingExperience
  equipmentAccess   GymEquipmentAccess @default(FULL_GYM)
  unit              WeightUnit         @default(KG)
  // S21 (T-42.0): null = derived from `unit` (MI when unit = LB, else KM).
  distanceUnit      DistanceUnit?
  weeklyGoal        Int
  /// [{ fromWeek: "YYYY-MM-DD" (Monday), goal: number }] — weeks are judged by the goal in force.
  goalHistory       Json               @default("[]")
  barWeightKg       Float              @default(20)
  platePairsKg      Float[]
  dumbbellsKg       Float[]
  machineStepKg     Float              @default(5)
  cableStepKg       Float              @default(2.5)
  hasDipBelt        Boolean            @default(false)
  microPlates       Boolean            @default(false)
  reminderEnabled   Boolean            @default(false)
  reminderTime      String? // "18:30" device-local
  /// Deload / stall / recap offer bookkeeping (dismissals, active deload window).
  offerState        Json               @default("{}")
  setupCompletedAt  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // S6, rev 2 (T-05.3, T-36.2, T-36.3, T-36.6)
  hasWeightedVest   Boolean            @default(false)
  /// Null = never (quiet-days nudge off); new setups write 5.
  quietNudgeDays    Int?
  sessionLengthMins Int?
  /// Per-weekday "HH:MM" overrides; {} = use the single reminderTime for every day.
  reminderTimes     Json               @default("{}")
  /// { exerciseId, fromSessionId, routineDayId }[] (CarryOverItem, @chefer/utils gym/carry-over.ts)
  carryOver         Json               @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gym_profiles")
}

model Routine {
  id          String    @id @default(cuid())
  userId      String
  name        String
  templateKey String?
  isActive    Boolean   @default(false)
  nextDayId   String? // rotation pointer
  version     Int       @default(1) // optimistic concurrency for document saves
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days RoutineDay[]

  @@index([userId, isActive])
  @@map("routines")
}

model RoutineDay {
  id             String @id @default(cuid())
  routineId      String
  position       Int
  name           String
  plannedWeekday Int? // 0 = Monday … 6 = Sunday

  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@index([routineId])
  @@map("routine_days")
}

model RoutineExercise {
  id            String  @id @default(cuid())
  dayId         String
  exerciseId    String
  position      Int
  sets          Int
  repMin        Int
  repMax        Int
  targetRir     Int     @default(2)
  restSec       Int
  supersetGroup String?
  notes         String?

  day      RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([dayId])
  @@map("routine_exercises")
}

model WorkoutSession {
  id                String        @id // client UUID
  userId            String
  routineId         String?
  routineDayId      String?
  name              String
  status            WorkoutStatus
  startedAt         DateTime
  finishedAt        DateTime?
  localDate         String // "YYYY-MM-DD" of startedAt on the device
  isDeload          Boolean       @default(false)
  notes             String?
  clientUpdatedAt   DateTime // last-write-wins guard for the sync upsert
  engineVersion     Int
  rotationAppliedAt DateTime? // set once, when completion advanced Routine.nextDayId
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  @@index([userId, localDate])
  @@index([userId, status])
  @@map("workout_sessions")
}

model SessionExercise {
  id                String  @id // client UUID
  sessionId         String
  exerciseId        String
  routineExerciseId String?
  position          Int
  repMin            Int
  repMax            Int
  targetRir         Int
  restSec           Int
  skipped           Boolean @default(false)
  swappedFromId     String?
  lastSetRir        Int? // 0..3 (3 = "3+")
  prescription      Json // { weightKg, reps[], reasonCode, inputs, engineVersion }
  notes             String?
  supersetGroup     String? // this session's superset letter (plan-library-supersets S-D3)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
  sets     SessionSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("session_exercises")
}

model SessionSet {
  id                String    @id // client UUID
  sessionExerciseId String
  position          Int
  weightKg          Float // external load; ASSISTED exercises store the assistance
  reps              Int
  isWarmup          Boolean   @default(false)
  completedAt       DateTime? // null = planned, not ticked
  // S20 (T-42.0, 06 §5.2) — cardio fields, all additive/nullable, null for
  // every strength set. A cardio entry is ONE row with weightKg: 0, reps: 0,
  // isWarmup: false; INTERVALS (W5) is one row per work/rest segment, with
  // `position` as the segment index.
  durationSec       Int? // DURATION, DURATION_DISTANCE, INTERVALS
  distanceM         Float? // DURATION_DISTANCE, DISTANCE — canonical metres
  intensityRpe      Int? // 1–10, any cardio type
  resistanceLevel   Int? // machine dial (bike/elliptical)
  inclinePct        Float? // treadmill/incline walk
  caloriesKcal      Float? // computed estimate or synced, always labeled as an estimate
  avgHeartRateBpm   Int? // reserved slot, never written from manual entry

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@map("session_sets")
}

model ExerciseProgression {
  userId        String
  exerciseId    String
  repBucket     String // e.g. "8-12" — gym_plan.md §2.1
  state         Json // ProgressionState (@chefer/types gym)
  override      Json? // user-edited next targets
  overrideAt    DateTime?
  engineVersion Int
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId, repBucket])
  @@map("exercise_progressions")
}

model TrainingPause {
  id        String   @id @default(cuid())
  userId    String
  startDate String // localDate, inclusive
  endDate   String // localDate, inclusive
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("training_pauses")
}

// ─── Following (docs/friends/implementation-plan.md §2) ──────────────────────
// Code name `friends`, user-facing name "Following". Every table cascades from
// User (account deletion). Turning Following off deletes the social rows in
// one transaction (SocialProfileRepository.deleteCascadeSocial) but keeps
// UserReport and ModerationLog (PRD FD-14).

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum NotificationKind {
  FOLLOW_REQUEST
  NEW_FOLLOWER
  REQUEST_ACCEPTED
}

enum ReportReason {
  INAPPROPRIATE
  SPAM
  HARASSMENT
  UNSAFE
  OTHER
}

enum RecipeHiddenReason {
  REPORTS
  FILTER
}

enum ModerationAction {
  RECIPE_AUTO_HIDDEN // reports threshold (plan §4.6)
  ACCOUNT_FORCED_PRIVATE // reports threshold
  RECIPE_FILTER_HIDDEN // word filter on an existing recipe at turn-on / recipes-on
  NAME_REJECTED // word filter rejected a display name
  RECIPE_TEXT_REJECTED // word filter rejected a shared recipe write
  UNDO // ops undo of an earlier row
}

/// One row = the user turned Following on. No row = not discoverable, not followable.
model SocialProfile {
  userId          String            @id
  visibility      ProfileVisibility @default(PRIVATE)
  /// normalizeSearchName(first, last) from @chefer/utils; rewritten on activate and on name change.
  searchName      String
  sharePlan       Boolean           @default(true)
  shareRecipes    Boolean           @default(true)
  shareWorkouts   Boolean           @default(true)
  shareTargets    Boolean           @default(false)
  /// Set by moderation (plan §4.6): visibility locked to PRIVATE, excluded from search and suggestions.
  forcedPrivateAt DateTime?
  /// Chefer Kitchen (Q-F-8): always eligible for "Popular". Set only by scripts/create-chefer-kitchen.ts.
  featured        Boolean           @default(false)
  activatedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, forcedPrivateAt])
  @@index([searchName])
  @@map("social_profiles")
}

/// Directed edge follower → followee. PENDING = request. Decline/cancel/unfollow/remove/block = delete.
model Follow {
  id         String       @id @default(cuid())
  followerId String
  followeeId String
  status     FollowStatus
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  follower User @relation("FollowsOut", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowsIn", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, status, createdAt])
  @@index([followerId, status, createdAt])
  @@map("follows")
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model SuggestionDismissal {
  userId          String
  dismissedUserId String
  createdAt       DateTime @default(now())

  user      User @relation("DismissalsMade", fields: [userId], references: [id], onDelete: Cascade)
  dismissed User @relation("DismissalsReceived", fields: [dismissedUserId], references: [id], onDelete: Cascade)

  @@id([userId, dismissedUserId])
  @@map("suggestion_dismissals")
}

/// Append-only. Kept when the target turns Following off (PRD FD-14), so leaving can't reset moderation.
model UserReport {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String // the reported user, or the reported recipe's creator
  recipeId     String? // no FK: the report outlives the recipe
  reason       ReportReason
  /// Counts toward thresholds: reporter account ≥ 24 h old and email verified, evaluated at report time.
  eligible     Boolean
  /// Set by an ops undo of the action this report contributed to; discounted reports never count again.
  discountedAt DateTime?
  createdAt    DateTime     @default(now())

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, eligible])
  @@index([recipeId, eligible])
  @@index([createdAt])
  @@map("user_reports")
}

/// Append-only log of every automatic moderation action and every ops undo (PRD §9.5).
model ModerationLog {
  id                String           @id @default(cuid())
  action            ModerationAction
  targetUserId      String
  recipeId          String?
  reason            String // e.g. "3 distinct eligible reporters", "blocked term in name"
  distinctReporters Int?
  actor             String // "system" | "ops"
  undoOfId          String? // for UNDO rows
  createdAt         DateTime         @default(now())

  target User @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetUserId])
  @@map("moderation_log")
}

/// In-app Activity. One row per (recipient, kind, actor): a re-sent request upserts it
/// (fresh createdAt, readAt = null) instead of stacking duplicates.
model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  kind      NotificationKind
  actorId   String
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user  User @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, actorId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
