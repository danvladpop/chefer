// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" for local dev. The production image is Alpine (musl) with
  // OpenSSL 3 — "native" alone resolves to the OpenSSL 1.1 musl engine there
  // and fails at runtime with `libssl.so.1.1: No such file`. Both musl
  // OpenSSL-3 engines are listed so the image works on x86_64 and ARM64 VMs.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  ATHLETE
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  EAT_HEALTHIER
}

enum RecipeSource {
  AI
  MANUAL
  CURATED
}

enum ImageStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}

enum MealPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AiCallType {
  MEAL_PLAN
  RECIPE_SWAP
  SHOPPING_LIST
  IMAGE_GENERATION
  INGREDIENT_PRICES
  CHAT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  firstName     String?
  lastName      String?
  image         String?
  role          UserRole  @default(USER)
  planTier      PlanTier  @default(FREE)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  posts              Post[]
  profile            UserProfile?
  chefProfile        ChefProfile?
  dietaryPreferences DietaryPreferences?
  mealPlans          MealPlan[]
  favouriteRecipes   FavouriteRecipe[]
  mealRatings        MealRating[]
  dailyLogs          DailyLog[]
  weightEntries      WeightEntry[]
  createdRecipes     Recipe[]            @relation("CreatedRecipes")
  aiCallLogs         AiCallLog[]

  @@index([email])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  website   String?
  location  String?
  twitter   String?
  github    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ChefProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  displayName        String?
  biologicalSex      BiologicalSex?
  age                Int?
  heightCm           Float?
  weightKg           Float?
  activityLevel      ActivityLevel?
  goal               Goal?
  dailyCalorieTarget Int?
  weeklyBudgetEur    Float?
  deliveryAddress    String?
  deliveryCurrency   String?        @default("EUR")
  preferredUnits     UnitSystem     @default(METRIC)
  updatedAt          DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chef_profiles")
}

model DietaryPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  cuisinePreferences   String[]
  dietaryRestrictions  String[]
  allergies            String[]
  dislikedIngredients  String[]
  mealsPerDay          Int      @default(3)
  servingSize          Int      @default(1)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dietary_preferences")
}

model Recipe {
  id            String       @id @default(cuid())
  name          String
  description   String
  ingredients   Json         // { name: string, quantity: number, unit: string }[]
  instructions  String[]
  nutritionInfo Json         // { calories: number, protein: number, carbs: number, fat: number, fiber: number }
  cuisineType   String
  dietaryTags   String[]
  prepTimeMins  Int
  cookTimeMins  Int
  servings      Int
  imageUrl      String?
  imageStatus   ImageStatus  @default(DONE)
  imageRetries  Int          @default(0)
  imagePriority Int          @default(100) // lower = generated first (0 = today)
  source        RecipeSource @default(AI)
  creatorId     String?
  createdAt     DateTime     @default(now())

  creator     User?             @relation("CreatedRecipes", fields: [creatorId], references: [id])
  favourites  FavouriteRecipe[]
  mealRatings MealRating[]

  @@index([creatorId])
  @@map("recipes")
}

model FavouriteRecipe {
  id            String   @id @default(cuid())
  userId        String
  recipeId      String
  savedAt       DateTime @default(now())
  useInNextPlan Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("favourite_recipes")
}

model MealPlan {
  id            String         @id @default(cuid())
  userId        String
  weekStartDate DateTime
  status        MealPlanStatus @default(DRAFT)
  createdAt     DateTime       @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  days MealPlanDay[]

  @@index([userId])
  @@map("meal_plans")
}

model MealPlanDay {
  id         String @id @default(cuid())
  mealPlanId String
  dayOfWeek  Int    // 0 = Monday … 6 = Sunday
  meals      Json   // { type: "breakfast"|"lunch"|"dinner"|"snack", recipeId: string }[]

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@map("meal_plan_days")
}

model MealRating {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  rating    Int      // 1–5 stars
  notes     String?
  ratedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("meal_ratings")
}

model DailyLog {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  loggedMeals  Json
  totalKcal    Int
  totalProtein Float
  totalCarbs   Float
  totalFat     Float
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_logs")
}

model WeightEntry {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("weight_entries")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String?    @db.Text
  excerpt     String?
  coverImage  String?
  published   Boolean    @default(false)
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags   PostTag[]

  @@index([authorId])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model AiCallLog {
  id        String      @id @default(cuid())
  userId    String
  callType  AiCallType
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_call_logs")
}

model IngredientImage {
  ingredientName String   @id
  imageUrl       String
  resolvedAt     DateTime @default(now())

  @@map("ingredient_images")
}

// The ingredient catalog / "vocabulary": store-agnostic baseline prices AND
// per-100g macros, per base-unit family so recipe quantities can be scaled
// (250 g spinach = 2.5 × pricePer100gEur). Refreshed periodically by
// IngredientPriceWorker (source AI_ESTIMATE). Rows with creatorId are a
// user's private custom ingredients (source USER, never AI-refreshed).
model IngredientPrice {
  ingredientName   String   @id // normalized lowercase
  pricePer100gEur  Float?
  pricePer100mlEur Float?
  pricePerPieceEur Float?
  // Macros per 100 g — drive auto-computed recipe nutrition
  caloriesPer100g  Float?
  proteinPer100g   Float?
  carbsPer100g     Float?
  fatPer100g       Float?
  fiberPer100g     Float?
  // Count-unit → grams conversion ("1 medium banana ≈ 118 g")
  gramsPerPiece    Float?
  imageUrl         String?
  creatorId        String? // null = global vocabulary; set = private custom ingredient
  source           String   @default("AI_ESTIMATE")
  estimatedAt      DateTime @default(now())

  @@index([creatorId])
  @@map("ingredient_prices")
}

// Persisted (AI-consolidated) shopping list for a meal plan. Written by
// shoppingList.regenerate so the Gemini result survives reloads; getForWeek
// serves it when present.
model ShoppingList {
  id          String   @id @default(cuid())
  planId      String   @unique
  items       Json     // ShoppingListItemForWeek[] minus images/prices (re-resolved)
  aiGenerated Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("shopping_lists")
}

model CarrefourPriceCache {
  ingredientName String   @id
  productName    String
  priceRon       Float
  resolvedAt     DateTime @default(now())

  @@map("carrefour_price_cache")
}
