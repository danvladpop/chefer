# Caddy reverse proxy for the single-origin Chefer deployment.
# Terminates TLS automatically via Let's Encrypt for ${PUBLIC_DOMAIN}
# (e.g. chefer.duckdns.org) and path-routes to the two app containers.
#
#   /trpc/*, /api/uploads/*, /api/recipe-images/*, /api/chat, /api/health,
#   /uploads/*, /static/exercises/*                                       -> api:3001
#   /.well-known/apple-app-site-association, /.well-known/assetlinks.json  -> api:3001
#     (password-manager association files; only these two paths, so Caddy's
#      own ACME challenges under /.well-known/acme-challenge/ are untouched)
#   everything else (pages, static)                                        -> web:3000
#
# The api and web hostnames resolve over the compose network.

{$PUBLIC_DOMAIN} {
	encode gzip

	# tRPC API
	@trpc path /trpc/*
	handle @trpc {
		reverse_proxy api:3001
	}

	# Backend-only API paths (uploads endpoint + SSE image stream + AI chat +
	# the canonical health check: API + DB, 503 when the DB is unreachable —
	# this is what the external uptime monitor watches, A12)
	@apiBackend path /api/uploads/* /api/recipe-images/* /api/chat /api/scan-meal /api/health
	handle @apiBackend {
		reverse_proxy api:3001 {
			# Streams (SSE image status, chat text): don't buffer
			flush_interval -1
		}
	}

	# Uploaded files + gym exercise photos (gym_plan.md §5.5) served statically by the API
	@uploads path /uploads/* /static/exercises/*
	handle @uploads {
		reverse_proxy api:3001
	}

	# iOS/Android password-manager association files (WP-22): JSON, 200, no redirect
	@wellKnown path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @wellKnown {
		reverse_proxy api:3001
	}

	# Everything else -> Next.js web (pages, assets)
	handle {
		reverse_proxy web:3000
	}
}
