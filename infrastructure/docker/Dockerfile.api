# API image — runs the TypeScript source directly with tsx (same as dev).
#
# Why tsx and not a tsc build: the monorepo resolves @chefer/* workspace packages
# as SOURCE (their package exports point at src/*.ts), so a project-wide `tsc`
# emit isn't set up (rootDir/paths conflicts). tsx transpiles on load and
# resolves the workspace source exactly like `pnpm dev`. Type safety is enforced
# separately via `pnpm typecheck`.

# ─── Stage 1: Dependencies ────────────────────────────────────────────────────
FROM node:20-alpine3.20 AS deps

RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# The API depends on these workspace packages (source):
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/tsconfig/package.json ./packages/config/tsconfig/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/
# Root package.json declares pnpm.patchedDependencies (mobile toolchain);
# pnpm hashes every patch file at install even though the patched package
# is not installed here, so the patches must be present.
COPY patches ./patches

# Full install (includes tsx, which the runtime uses)
RUN pnpm install --frozen-lockfile --ignore-scripts

# ─── Stage 2: Runner ──────────────────────────────────────────────────────────
FROM node:20-alpine3.20 AS runner

RUN apk add --no-cache dumb-init curl openssl

# ─── Video-link recipe import (apps/api/src/lib/video-import) ────────────────
# yt-dlp reads a video's metadata/captions and downloads its AUDIO only;
# ffmpeg turns that into 16 kHz mono mp3 for Whisper. Both pinned.
#
# ffmpeg: the Alpine 3.20 package (6.1.x), security-patched with the base image.
#
# yt-dlp: the official standalone musl binary (no Python needed; bundles the
# YouTube JS-challenge solver and uses the node already in this image). It
# BREAKS whenever YouTube/TikTok/Instagram change their sites, so bump it
# often — see infrastructure.md §12 "Bumping yt-dlp": set YTDLP_VERSION and
# both SHA-256s from the release's SHA2-256SUMS, rebuild, run the smoke check.
ARG YTDLP_VERSION=2026.08.19
ARG YTDLP_SHA256_AMD64=f3dec9cfeaf304cec98290fe41c6ad465d4b747d302473559643e7af24929722
ARG YTDLP_SHA256_ARM64=17b164c4d258be92bb1ad146cb7c336b783aedb380814aabbcb7d52937f77e57
ARG TARGETARCH
RUN apk add --no-cache 'ffmpeg~6.1' && \
    arch="${TARGETARCH:-$(uname -m)}" && \
    case "$arch" in \
      amd64|x86_64) asset=yt-dlp_musllinux; sum="$YTDLP_SHA256_AMD64" ;; \
      arm64|aarch64) asset=yt-dlp_musllinux_aarch64; sum="$YTDLP_SHA256_ARM64" ;; \
      *) echo "yt-dlp: unsupported architecture $arch" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /usr/local/bin/yt-dlp \
      "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${asset}" && \
    echo "${sum}  /usr/local/bin/yt-dlp" | sha256sum -c - && \
    chmod 755 /usr/local/bin/yt-dlp

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0

# Dependencies — copy the whole installed tree (workspace packages without
# dependencies have no node_modules dir, so per-package COPYs are brittle)
COPY --from=deps /app ./

# Source
COPY packages/config/tsconfig ./packages/config/tsconfig
COPY packages/types ./packages/types
COPY packages/utils ./packages/utils
COPY packages/database ./packages/database
COPY apps/api ./apps/api

# Generate the Prisma client (binaryTargets includes linux-musl-arm64 for ARM VMs)
RUN cd packages/database && npx prisma generate

# Non-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 apiuser && \
    chown -R apiuser:nodejs /app
USER apiuser

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# tsx runs the TS entrypoint; workspace @chefer/* imports resolve to source.
# tsx bin lives in the api package's node_modules (pnpm doesn't hoist it to root).
ENTRYPOINT ["dumb-init", "--"]
CMD ["apps/api/node_modules/.bin/tsx", "apps/api/src/index.ts"]
