# ─── Stage 1: Dependencies ────────────────────────────────────────────────────
FROM node:20-alpine3.20 AS deps

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy workspace manifests first for better layer caching.
# NOTE: the web app depends on @chefer/api and @chefer/database (workspace:*)
# for end-to-end tRPC types, so their manifests must be present for install.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/tsconfig/package.json ./packages/config/tsconfig/
COPY packages/config/eslint/package.json ./packages/config/eslint/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ui/package.json ./packages/ui/
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile --ignore-scripts

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM node:20-alpine3.20 AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Dependencies — copy the whole installed tree. Enumerating per-package
# node_modules is brittle: workspace packages with no dependencies (e.g.
# @chefer/tsconfig) never get a node_modules dir, and the COPY then fails.
COPY --from=deps /app ./

# Source (include database + api for the tRPC AppRouter type closure)
COPY turbo.json ./
COPY packages/config/tsconfig ./packages/config/tsconfig
COPY packages/types ./packages/types
COPY packages/utils ./packages/utils
COPY packages/ui ./packages/ui
COPY packages/database ./packages/database
COPY apps/api ./apps/api
COPY apps/web ./apps/web

# Build-time public env (baked into the client bundle)
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME=Chefer

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NODE_ENV=production
ENV BUILD_STANDALONE=true
ENV NEXT_TELEMETRY_DISABLED=1

# Prisma client is needed for @chefer/database's generated types during the build
RUN cd packages/database && npx prisma generate

RUN pnpm --filter @chefer/web build

# ─── Stage 3: Runner ──────────────────────────────────────────────────────────
FROM node:20-alpine3.20 AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Next.js standalone output traces only the real runtime deps → small image
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["node", "apps/web/server.js"]
