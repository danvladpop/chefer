# Copy to .env.production on the VM and fill in real values. NEVER commit .env.production.
# Used by docker-compose.deploy.yml (both container env and build args).

# ── Public hostname (DuckDNS free subdomain) ─────────────────────────────────
# Caddy issues TLS for this and it's the origin the browser uses.
PUBLIC_DOMAIN=chefer.duckdns.org

# ── Postgres (container, internal only) ──────────────────────────────────────
POSTGRES_USER=chefer
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=chefer

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://chefer:CHANGE_ME_strong_db_password@postgres:5432/chefer

# Generate fresh (do NOT reuse dev secrets):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_min_32_chars
REFRESH_TOKEN_SECRET=CHANGE_ME_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Single-origin: the browser only ever talks to PUBLIC_DOMAIN, so CORS is the
# same host. (Kept for safety; not exercised same-origin.)
CORS_ORIGINS=https://chefer.duckdns.org

# ── AI ───────────────────────────────────────────────────────────────────────
AI_MOCK_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_gemini_key

# ── Web (baked at build time) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://chefer.duckdns.org
NEXT_PUBLIC_APP_URL=https://chefer.duckdns.org
NEXT_PUBLIC_APP_NAME=Chefer

# ── DuckDNS updater (only if using an ephemeral VM IP; omit if IP is reserved) ─
DUCKDNS_SUBDOMAIN=chefer
DUCKDNS_TOKEN=CHANGE_ME_duckdns_token
